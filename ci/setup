#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then echo 'usage: ci/setup SCRATCH' >&2; exit 1; fi
for tool in python3 dirname mkdir; do
    command -v "$tool" >/dev/null 2>&1 || { echo "missing tool: $tool" >&2; exit 1; }
done
case "$1" in
    /*) ;;
    *) echo 'SCRATCH must be an absolute path' >&2; exit 1 ;;
esac
cd "$(dirname "$0")/.."
mkdir -p "$1/tmp"
export TMPDIR="$1/tmp"
python3 -m pip --version >/dev/null 2>&1 || { echo 'missing tool: pip' >&2; exit 1; }
exec python3 -m pip install '.[dev]'
